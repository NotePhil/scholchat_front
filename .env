# Production server port
PORT=3000

# Backend API URL.
#   - `npm run dev` (development)  -> .env.development (http://localhost:8486/scholchat)
#   - `npm run build` (production) -> .env.production  (https://scholchat-business-latest.onrender.com/scholchat)
# Those files take precedence over this one; this value is only a fallback.
REACT_APP_API_BASE_URL=http://localhost:8486/scholchat


# Memory optimization
GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=false
FAST_REFRESH=true
TSC_COMPILE_ON_ERROR=true

# Build optimization
BUILD_PATH=build
CI=false
INLINE_RUNTIME_CHUNK=false

# Node options for memory
NODE_OPTIONS=--max_old_space_size=4096

# Disable ESLint warnings in production
ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true
