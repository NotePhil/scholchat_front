# Used automatically by `npm run build` (CRA loads .env.production on top of .env).
# Production backend (Render). Override at build time on the host if it ever moves.
REACT_APP_API_BASE_URL=https://scholchat-business-latest.onrender.com/scholchat

# Temporarily off: the deployed backend doesn't allow the X-Timezone header in CORS yet.
# Remove this line once the new backend (which allows X-Timezone) is live on Render.
REACT_APP_SEND_TIMEZONE_HEADER=false
